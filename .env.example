# ==========================================
# CONFIGURATION EVOBOT — VARIABLES D'ENVIRONNEMENT
# ==========================================

# Token de votre Bot Telegram obtenu auprès de @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Chat ID Telegram de l'administrateur pour la réception des commandes (@userinfobot)
OWNER_CHAT_ID=your_owner_chat_id_here

# URL publique de déploiement de la Mini App (ex: https://evobot.onrender.com)
WEBAPP_URL=http://localhost:3000

# Port du serveur Express (défaut : 3000)
PORT=3000
